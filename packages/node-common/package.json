{
  "name": "@sagamart/node-common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared building blocks for Sagamart's Node services: logging, telemetry, config, Problem Details, internal identity.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-prometheus": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.0.0",
    "jose": "6.2.13"
  }
}
