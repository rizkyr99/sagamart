{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagamart.dev/schemas/events/schemas/inventory.reservation.expired.v1.schema.json",
  "title": "inventory.reservation.expired/v1",
  "description": "A reservation passed its TTL before it was committed or released, and its stock was returned (RFC-0001 §4.4). Consumed by the Order saga, which cancels the order.",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "inventory.reservation.expired" },
    "source": { "const": "inventory" },
    "dataschema": { "const": "inventory.reservation.expired/v1" },
    "data": {
      "type": "object",
      "required": ["orderId", "reservationId", "lines", "expiredAt"],
      "properties": {
        "orderId": { "description": "Also the event subject.", "type": "string", "format": "uuid" },
        "reservationId": { "type": "string", "format": "uuid" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sku", "quantity"],
            "properties": {
              "sku": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "expiredAt": { "description": "When the stock was released, UTC.", "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
