# Local development only. Copied to .env by `make up`; .env is never committed.
COMPOSE_PROJECT_NAME=sagamart

# One Postgres container per service (ADR-0004). Dev-only credentials.
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_PORT=5433

ORDER_DB_USER=order
ORDER_DB_PASSWORD=order
ORDER_DB_PORT=5434

PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment
PAYMENT_DB_PORT=5435

INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory
INVENTORY_DB_PORT=5436

REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=19644
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_CONSOLE_PORT=8080

REDIS_PORT=6380
DYNAMODB_PORT=8001

MEILI_PORT=7700
MEILI_MASTER_KEY=sagamart-dev-master-key-change-me

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Services (deploy/compose/services.yml)
INVENTORY_HTTP_PORT=8110
INVENTORY_GRPC_PORT=9110
CATALOG_HTTP_PORT=8120
GATEWAY_HTTP_PORT=8100

# Internal identity (contracts/identity.md). Generate local keys with `make identity-keys`; never commit real ones.
IDENTITY_KEY_ID=
IDENTITY_PRIVATE_KEY=
IDENTITY_PUBLIC_KEYS=
# Development JWTs for the gateway (POST /v1/dev/token); also written by `make identity-keys`.
GATEWAY_DEV_JWT_SECRET=
