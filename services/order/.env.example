# For `./mvnw spring-boot:run` from source against `make up` infrastructure. Copy to .env and export it
# (`set -a; . ./.env; set +a`); .env is never committed.
ORDER_ENV=local
ORDER_LOG_LEVEL=info
ORDER_DB_URL=jdbc:postgresql://localhost:5434/order
ORDER_DB_USER=order
ORDER_DB_PASSWORD=order
ORDER_HTTP_PORT=8140
ORDER_GRPC_PORT=9140
ORDER_SHUTDOWN_TIMEOUT=15s
# ORDER_VERSION defaults to the pom version. ORDER_MIGRATE_ON_START defaults to true, and to false in prod.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
