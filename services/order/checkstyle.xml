<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Layout is google-java-format's job (Spotless). Checkstyle catches what a formatter can't (conventions §12). -->
<module name="Checker">
  <property name="severity" value="warning"/>
  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="NeedBraces"/>
    <module name="EmptyCatchBlock"/>
    <module name="EqualsHashCode"/>
    <module name="MissingOverride"/>
    <module name="OneStatementPerLine"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="FallThrough"/>
    <module name="MissingSwitchDefault"/>
    <!-- Conventions §12: constructor injection only; Spring needs no annotation for a single constructor. -->
    <module name="IllegalImport">
      <property name="illegalClasses" value="org.springframework.beans.factory.annotation.Autowired"/>
    </module>
  </module>
</module>
