# For `make run` from source against `make up` infrastructure. Copy to .env; .env is never committed.
INVENTORY_ENV=local
INVENTORY_LOG_LEVEL=info
INVENTORY_DB_URL=postgres://inventory:inventory@localhost:5436/inventory?sslmode=disable
INVENTORY_HTTP_ADDR=:8110
INVENTORY_GRPC_ADDR=:9110
INVENTORY_MAX_LINE_QUANTITY=100
INVENTORY_SHUTDOWN_TIMEOUT=15s
INVENTORY_EXPIRY_INTERVAL=5s
INVENTORY_KAFKA_BROKERS=localhost:19092
# Gateway public keys: copy IDENTITY_PUBLIC_KEYS from deploy/compose/.env after `make identity-keys`.
INVENTORY_IDENTITY_PUBLIC_KEYS='{"<kid>":"<SPKI DER, base64>"}'
INVENTORY_EVENTS_TOPIC=inventory.events
INVENTORY_OUTBOX_INTERVAL=200ms
# INVENTORY_MIGRATE_ON_START defaults to true in local and test, false in prod.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
