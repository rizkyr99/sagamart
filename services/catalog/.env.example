# For running from source against `make up` infrastructure. Copy to .env; .env is never committed.
# Run `make identity-keys` at the repo root first and copy IDENTITY_PUBLIC_KEYS from deploy/compose/.env.
CATALOG_ENV=local
CATALOG_LOG_LEVEL=info
CATALOG_HTTP_PORT=8120
CATALOG_DB_URL=postgres://catalog:catalog@localhost:5433/catalog
CATALOG_DYNAMODB_ENDPOINT=http://localhost:8001
CATALOG_DYNAMODB_REGION=ap-southeast-3
CATALOG_CARTS_TABLE=carts
CATALOG_IDENTITY_PUBLIC_KEYS='{"<kid>":"<SPKI DER, base64>"}'
# CATALOG_MIGRATE_ON_START and CATALOG_DYNAMODB_CREATE_TABLE default to true in local and test, false in prod.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
