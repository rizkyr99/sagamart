# For running from source against `make up` infrastructure. Copy to .env; .env is never committed.
# Run `make identity-keys` at the repo root first and copy IDENTITY_KEY_ID, IDENTITY_PRIVATE_KEY and
# GATEWAY_DEV_JWT_SECRET from deploy/compose/.env.
GATEWAY_ENV=local
GATEWAY_LOG_LEVEL=info
GATEWAY_HTTP_PORT=8100
GATEWAY_DEV_AUTH=true
GATEWAY_DEV_JWT_SECRET=<at least 32 characters>
GATEWAY_IDENTITY_KEY_ID=<kid>
GATEWAY_IDENTITY_PRIVATE_KEY=<PKCS#8 DER, base64>
GATEWAY_CATALOG_URL=http://localhost:8120
GATEWAY_REDIS_URL=redis://localhost:6380
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
