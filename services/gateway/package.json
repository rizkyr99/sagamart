{
  "name": "@sagamart/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API gateway / BFF (NestJS): public REST API, dev auth, internal identity, rate limiting. RFC-0005.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter \"@sagamart/gateway^...\" build && vitest run --coverage",
    "start": "node --import ./dist/instrument.js dist/main.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@sagamart/contracts": "workspace:*",
    "@sagamart/node-common": "workspace:*",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@sagamart/contract-testing": "workspace:*",
    "@swc/core": "1.16.18",
    "@testcontainers/redis": "12.2.1",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "unplugin-swc": "2.0.0"
  }
}
